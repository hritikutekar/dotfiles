{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logos/goku.txt",
  },
  "display": {
    "separator": ": ",
  },
  "modules": [
    { "type": "title" },
    { "type": "separator" },
    { "type": "os" },
    { "type": "host" },
    { "type": "kernel" },
    { "type": "uptime" },
    { "type": "packages" },
    { "type": "shell" },
    { "type": "resolution" },
    { "type": "theme" },
    { "type": "icons" },
    { "type": "font" },
    { "type": "cpu" },
    { "type": "gpu" },
    { "type": "memory" },
    { "type": "disk" },
    { "type": "locale" },
    { "type": "localip" }, // Your local WiFi IP
    { "type": "colors" }, // The colored blocks at the bottom
  ],
}
